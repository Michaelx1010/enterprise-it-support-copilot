# Reference only: export these variables in your shell; .env is not auto-loaded.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_RECOMMENDATION_MODEL=gpt-4.1-mini-2025-04-14

# Milestone 2A. Load explicitly with uv run --env-file .env.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=
POSTGRES_DB=it_support
POSTGRES_USER=it_support
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Optional, separate disposable database for integration tests.
TEST_DATABASE_URL=
# Optional database image/volume overrides for an existing local setup.
# PGVECTOR_IMAGE=pgvector/pgvector:0.8.1-pg17
# KB_VOLUME_NAME=it-support-kb-data
